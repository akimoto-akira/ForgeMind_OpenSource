<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ForgeMindServerTest</AssemblyName>
    <RootNamespace>ForgeMindServer.Test</RootNamespace>
    <Company>Hoshino Kennji</Company>
    <Version>1.0.0.0</Version>
    <Description>ForgeMindServer test runner — ITestCase harness + Task cases, extracted from ForgeMindServer/Test</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host hook is for a top-level host build only: see BuildPluginsAfterHostBuild. -->
    <ProjectReference Include="..\..\OpenSource\ForgeMindServer\ForgeMindServer.csproj"
                      AdditionalProperties="BuildPluginsOnHostBuild=false" />
  </ItemGroup>

  <!-- The demo plays on the console: the recording surface is the terminal, so no UI toolkit is
       referenced here at all. The demo window this project used to carry needed Avalonia, a message
       pump and a layout pass to show the same three lines a turn produces, and every one of them was
       a way for the run to go wrong. -->

</Project>

