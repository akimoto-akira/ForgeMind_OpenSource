<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ForgeMindServer</AssemblyName>
    <RootNamespace>ForgeMindServer</RootNamespace>
    <Company>Hoshino Kennji</Company>
    <Version>1.0.0.0</Version>
    <Authors>HoshinoKennji</Authors>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>ForgeMindServer MCP server — Unreal Engine tooling exposed over Model Context Protocol (stdio)</Description>
    <!-- stdout is reserved for the MCP JSON-RPC channel -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test runner (ForgeMindServerTest, a standalone exe) takes over the original host's Test mode;
         it needs the host service to be running (ForgeMindServerHost.Tools is internal).
         OpenSource internals are visible to the test project only — not to Commercial. -->
    <InternalsVisibleTo Include="ForgeMindServerTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- UE engine registry detection (HKCU Epic Games builds) compile-time reference -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Machine code generation (WMI query of CPU ProcessorId + motherboard SerialNumber) -->
    <PackageReference Include="System.Management" Version="9.0.0" />
    <!-- Roslyn: C# DSL code compilation & syntax-tree traversal -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host's project reference to the Speedy data-pack library (.NET 9 transitive by default;
         the host does not directly consume it now — kept per the refactor plan so plugins can share the packing capability) -->
    <ProjectReference Include="..\ForgeMind.Speedy\ForgeMind.Speedy.csproj" />
    <!-- Generic scan contract (refactor plan §3/§11): read/write scan-data contract moved out
         of the host — the host keeps only its provider implementation, not the contract -->
    <ProjectReference Include="..\ForgeMind.Scan.Abstractions\ForgeMind.Scan.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DSL domain offline-data JSON (formerly generated by the removed DSL/Scanning scanner, master Requirements.md §2.2):
         embedded as an assembly resource. The scanner side has been deleted; no consumer in the current runtime —
         to be fed in by ForgeMindDocumentEngine once its data format is fixed (DSL/Catalog is the entry point).
         Naming convention: DSL\Resources\{AssetType}Data_{EngineVersion}.json -->
        <EmbeddedResource Include="DSL\Resources\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The standalone probe project and probe sources under Debug\ do not participate in the main-service build:
         the SDK's default glob (**/*.cs) also picks up the auto-generated AssemblyInfo.cs / .NETCoreApp
         .AssemblyAttributes.cs under Debug\probe\obj\, which would collide with the main project's own
         generated files into CS0579 duplicate attributes (once caused 8 compile errors).
         We exclude them explicitly here; Debug\DebugDocumentTool.cs still compiles normally. -->
    <Compile Remove="Debug\probe\**;Debug\ProbeLastIndex.cs" />
    <None Remove="Debug\probe\**;Debug\ProbeLastIndex.cs" />
    <Content Remove="Debug\probe\**;Debug\ProbeLastIndex.cs" />
    <EmbeddedResource Remove="Debug\probe\**;Debug\ProbeLastIndex.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Build plugins alongside the host (to catch plugin breakage from host-API changes immediately,
         rather than postponing the error to runtime).
         Plugin → host is a ProjectReference; a reverse host → plugin ProjectReference would form a cycle (MSB1021),
         so we use a "post-build hook + separate process": the Exec-launched dotnet is an independent
         MSBuild instance, exempt from the current instance's circular-detection constraint;
         BuildPluginsOnHostBuild acts as the recursion switch so the host build inside the separate
         process does not re-trigger this target — we only chain one level deep. -->
    <BuildPluginsOnHostBuild Condition="'$(BuildPluginsOnHostBuild)' == ''">true</BuildPluginsOnHostBuild>
    <ForgeMindEdition Condition="'$(ForgeMindEdition)' == ''">Open</ForgeMindEdition>
  </PropertyGroup>

  <ItemGroup>
    <!-- Open plugins: independent deliverables, not in the host .sln. Listed here so host
         API changes co-compile the open plugin set. -->
    <ForgeMindOpenPluginProject Include="$(MSBuildThisFileDirectory)..\ForgeMind.OfflineEngineKit\ForgeMind.OfflineEngineKit.csproj" />
    <ForgeMindOpenPluginProject Include="$(MSBuildThisFileDirectory)..\ForgeMind.Assets\ForgeMind.Assets.csproj" />
    <ForgeMindOpenPluginProject Include="$(MSBuildThisFileDirectory)..\ForgeMind.EngineScanner\ForgeMind.EngineScanner.csproj" />
    <ForgeMindOpenPluginProject Include="$(MSBuildThisFileDirectory)..\ForgeMind.Knowledge\ForgeMind.Knowledge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ForgeMindPluginProject Include="@(ForgeMindOpenPluginProject)" />
  </ItemGroup>

  <Target Name="BuildPluginsAfterHostBuild"
          AfterTargets="Build"
          Condition="'$(BuildPluginsOnHostBuild)' == 'true'">
    <Message Importance="high" Text="[ForgeMind] Host built — chaining $(ForgeMindEdition) plugin compile..." />
    <!-- Exec defaults to ContinueOnError=false: a plugin compile failure fails the host build, which is exactly the point of this hook. -->
    <Exec Command="dotnet build &quot;%(ForgeMindPluginProject.FullPath)&quot; -c $(Configuration) -v quiet -p:BuildPluginsOnHostBuild=false" />
  </Target>
  <!-- Note: plugin build invocation does not happen here.
       Plugin → host is a ProjectReference; a reverse host → plugin ProjectReference would form a cycle (MSB1021);
       and plugins are independent deliverables that do not participate in the host build graph.
       Build & drop are unified by ForgeMindServerTest's pre-compile step
       (build host + all plugins, and drop outputs into the host's plugins directory). -->

</Project>