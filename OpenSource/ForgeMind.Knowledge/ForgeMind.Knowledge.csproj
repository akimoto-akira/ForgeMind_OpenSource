<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ForgeMind.Knowledge</AssemblyName>
    <RootNamespace>ForgeMind.Knowledge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sole code dependency: Speedy data packaging library (used only by Release-stage .spk backend) -->
    <ProjectReference Include="..\ForgeMind.Speedy\ForgeMind.Speedy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host runtime public surface (Compat / Plugins / Engine / Authorization):
         Referenced via ProjectReference, Private=false so it is not copied with plugin output (provided by host at runtime),
         while establishing correct build order (host builds before plugin). Host is an exe project,
         its output serves as referenced assembly consumed by the plugin and is not copied to the plugin output directory. -->
    <ProjectReference Include="..\ForgeMindServer\ForgeMindServer.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Textbook data: Knowledge\ at repo root copied to output directory, read at runtime by UeKnowledgeStore -->
    <None Include="..\..\Knowledge\**" Link="Knowledge\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin manifest ships next to the DLL so PluginLoader can discover it -->
    <None Include="ForgeMind.Knowledge.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
