<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ForgeMind.Knowledge</AssemblyName>
    <RootNamespace>ForgeMind.Knowledge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一的代码依赖：Speedy 数据打包库（仅 Release 阶段的 .spk 后端使用） -->
    <ProjectReference Include="..\ForgeMind.Speedy\ForgeMind.Speedy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 宿主运行时公共面（Compat / Plugins / Engine / Authorization）：
         以 ProjectReference 引用，Private=false 不随插件输出复制（由宿主在运行时提供），
          同时建立正确构建顺序（宿主先于插件编译）。宿主为 exe 工程，
          其输出作为引用程序集被插件消费，且不会被复制到插件输出目录。 -->
    <ProjectReference Include="..\ForgeMindServer\ForgeMindServer.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 教材数据：仓库根的 Knowledge\ 复制到输出目录，运行时由 UeKnowledgeStore 读取 -->
    <None Include="..\..\Knowledge\**" Link="Knowledge\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin manifest ships next to the DLL so PluginLoader can discover it -->
    <None Include="ForgeMind.Knowledge.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
