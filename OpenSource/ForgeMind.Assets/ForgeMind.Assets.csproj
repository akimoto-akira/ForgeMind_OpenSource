<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ForgeMind.Assets</AssemblyName>
    <RootNamespace>ForgeMind.Assets</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host runtime public surface (Compat / Plugins / Bridge / Engine):
         referenced but not copied to the plugin output; the host supplies it at runtime -->
    <ProjectReference Include="..\ForgeMindServer\ForgeMindServer.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin manifest ships next to the DLL so PluginLoader can discover it -->
    <None Include="ForgeMind.Assets.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
